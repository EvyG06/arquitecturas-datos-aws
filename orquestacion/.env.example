# Variables que lee docker-compose.yml. El archivo real es orquestacion/.env, esta fuera de git (.gitignore)
# y lo crea setup_ec2.sh en la EC2 con secretos aleatorios y permisos 600. Este ejemplo no tiene secretos.
# Para crearlo a mano:  cp orquestacion/.env.example orquestacion/.env  y reemplaza cada valor <...>.

# Usuario con el que corren los contenedores de Airflow
AIRFLOW_UID=50000

# Region y buckets. La cuenta sale del documento de identidad de la instancia (IMDSv2).
AWS_REGION=us-east-2
DL_BUCKET=eve-dl-<cuenta>-us-east-2
DW_BUCKET=eve-dw-<cuenta>-us-east-2

# Secretos de Airflow. setup_ec2.sh los genera con openssl rand. Nunca se suben al repositorio.
POSTGRES_PASSWORD=<openssl rand -hex 24>
AIRFLOW_FERNET_KEY=<openssl rand -base64 32 | tr '+/' '-_'>
AIRFLOW_SECRET_KEY=<openssl rand -hex 32>
# Contrasena del usuario admin de la interfaz web. Se lee solo en una sesion interactiva de SSM.
AIRFLOW_ADMIN_PASSWORD=<openssl rand -base64 18 | tr -d '/+='>

# ---------------------------------------------------------------------------------------------------------
# Lo siguiente NO va en .env. Se documenta aqui para tener en un solo lugar todo lo que configura el pipeline.
#
# Parametros de SSM Parameter Store (String, sin secretos) que leen los modulos del DW en /arq-datos/dw/:
#   mysql_host, docdb_host                          endpoints de RDS for MySQL y DocumentDB
#   mysql_secret_arn, docdb_secret_arn              secretos maestros (solo los lee el rol arq-datos-fuentes)
#   mysql_reader_secret_arn, docdb_reader_secret_arn  secretos de etl_lector (los lee el pipeline)
#   redshift_host, redshift_workgroup, redshift_database
#   redshift_copy_role_arn                          rol que usa COPY para leer S3
#   redshift_admin_secret_arn                       secreto del admin, administrado por Redshift
#   redshift_bi_secret_arn                          secreto de bi_lector, el usuario de QuickSight
#   quicksight_user_arn, quicksight_vpc_connection_arn, quicksight_dataset_id
#
# Variables opcionales que se pasan por ejecucion (dw.sh las reenvia al contenedor):
#   DW_FAULT=carga_a_mitad | carga_antes_de_copy | extraccion_a_mitad | extraccion_antes_de_confirmar
#   DW_CDC_SOLAPE_SEGUNDOS=300                      solape de la ventana CDC, por defecto 5 minutos
#   DL_FAULT=silver_antes_de_publicar | gold_antes_de_publicar   (el DAG la fija solo en el primer intento)
#
# Fijas en docker-compose.yml: AWS_PROFILE=pipeline, AWS_CONFIG_FILE=/opt/airflow/aws/config, DW_AWS=1,
# RDS_CA_BUNDLE=/opt/certs/rds-global-bundle.pem
#
# En el Mac, infra/env.sh (cargado por el alias arq) define AWS_PROFILE=admin, AWS_REGION, ACCOUNT_ID,
# DL_BUCKET, DW_BUCKET, PYTHONPATH y AIRFLOW_INSTANCE. ~/.aws/config necesita los perfiles admin y pipeline.
